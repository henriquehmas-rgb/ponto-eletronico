# =============================================================================
# Ponto Eletronico — .gitignore
# Regra da casa: SEGREDO NUNCA ENTRA NO GIT. Somente arquivos *.example.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. SEGREDOS E CREDENCIAIS  (bloco mais importante — nao relaxar)
# -----------------------------------------------------------------------------
.env
.env.*
*.env
env/.env

# Chaves, certificados e material criptografico
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.crt
*.cer
*.der
*.csr
*.asc
*.gpg
# Assinaturas CAdES geradas (AFD/AEJ/comprovantes).
# .gitignore NAO aceita comentario no fim da linha de padrao: o texto vira
# parte do padrao e a regra para de funcionar em silencio.
*.p7s
*.p7b
*.p7m
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*

# Chaves JWT do projeto (geradas localmente, nunca versionadas)
infra/keys/
secrets/
*.secret
*.secrets
credentials.json
service-account*.json

# Android / iOS
local.properties
key.properties
*.mobileprovision
GoogleService-Info.plist
google-services.json

# EXCECOES EXPLICITAS — templates versionaveis, sem valor real
!.env.example
!.env.*.example
!**/.env.example
!**/.env.*.example
!*.example
!docs/**/*.pem.example

# -----------------------------------------------------------------------------
# 2. BIOMETRIA E MIDIA SENSIVEL (LGPD art. 5, II) — nada disso entra no repo
# -----------------------------------------------------------------------------
# Fotos de captura, frames, provas de vida
capturas/
captures/
faces/
fotos/
photos/
enrollment/
# ATENCAO: NAO usar os padroes genericos "biometria/" ou "biometrics/" —
# colidem com codigo-fonte legitimo (apps/api/app/biometria/,
# apps/api/tests/f2/biometria/), do mesmo jeito que "models/" colidiria com
# packages/contracts/models/ (ver aviso abaixo). O runtime de midia sensivel
# fica coberto pelos padroes ANCORADOS logo a seguir.
**/media/biometria/
**/media/capturas/
**/storage/biometria/
**/storage/biometrics/

# Embeddings / templates faciais
embeddings/
*.embedding
*.embeddings
*.npy
*.npz
templates_faciais/
face_templates/
*.template

# Modelos do motor facial (pesados e/ou licenciados)
# ATENCAO: NAO usar o padrao generico "models/" — colide com
# packages/contracts/models/ e com os modulos models/ do SQLAlchemy.
ml-models/
modelos-faciais/
**/facial-svc/models/
**/facial-svc/weights/
*.onnx
*.tflite
*.pt
*.pth
*.pb
*.mlmodel
*.engine
*.trt
*.caffemodel
*.weights

# Arquivos fiscais gerados localmente (contem CPF de pessoa real).
# Diretorios ancorados na raiz (barra inicial) de proposito: um "afd/" solto
# excluiria tests/fixtures/afd/, e o git nao consegue re-incluir arquivo dentro
# de diretorio excluido — a excecao das fixtures, abaixo, nunca funcionaria.
/afd/
/aej/
/comprovantes/
infra/afd/
infra/aej/
*.afd
*.aej

# EXCECAO: fixtures legais de referencia (golden dataset das fases 3, 4 e 12).
# Sao versionadas de proposito — o motor de calculo e o gerador de AFD/AEJ sao
# testados contra elas. OBRIGATORIO: somente dados sinteticos, nenhum CPF real.
!tests/fixtures/**/*.afd
!tests/fixtures/**/*.aej
!tests/fixtures/**/*.p7s

