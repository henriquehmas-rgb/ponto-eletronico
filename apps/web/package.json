{
  "name": "@ponto/web",
  "version": "0.1.0",
  "private": true,
  "description": "Aplicacao web do SEEG Ponto (REP-P multiempresa) — Next.js 15, App Router.",
  "type": "module",
  "engines": {
    "node": ">=24",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "lint:corrigir": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:observar": "vitest",
    "tokens": "node scripts/tokens-para-css.mjs",
    "tokens:check": "node scripts/tokens-para-css.mjs --check",
    "tipos:api": "node scripts/tipos-da-api.mjs",
    "tipos:api:check": "node scripts/tipos-da-api.mjs --check",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:storybook": "node .storybook/testar-estatico.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.35",
    "@tanstack/react-query": "^5.62.0",
    "@tanstack/react-virtual": "^3.11.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "leaflet-draw": "^1.0.4",
    "lucide-react": "^0.468.0",
    "next": "^15.5.0",
    "openapi-fetch": "^0.13.0",
    "radix-ui": "^1.6.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.0",
    "react-leaflet": "^5.0.0",
    "recharts": "^2.15.0",
    "serwist": "^9.0.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "^1.62.0",
    "@serwist/next": "^9.0.0",
    "@storybook/addon-a11y": "^10.5.4",
    "@storybook/nextjs": "^10.5.4",
    "@storybook/test-runner": "^0.24.4",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/leaflet": "^1.9.21",
    "@types/leaflet-draw": "^1.0.13",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "axe-playwright": "^2.2.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.5.0",
    "eslint-config-prettier": "^9.1.0",
    "http-server": "^14.1.1",
    "jsdom": "^25.0.1",
    "openapi-typescript": "^7.5.0",
    "playwright": "^1.62.0",
    "prettier": "^3.4.2",
    "storybook": "^10.5.4",
    "tailwindcss": "^4.0.0",
    "tw-animate-css": "^1.2.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "vite": "^6.4.3",
      "js-yaml": "^4.3.0",
      "sharp": "^0.35.0",
      "postcss": "^8.5.18",
      "brace-expansion": "^5.0.8"
    }
