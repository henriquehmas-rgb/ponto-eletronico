# =============================================================================
# Ponto Eletronico — modelo de variaveis de ambiente
# =============================================================================
# Copie para infra/.env e preencha. O arquivo .env NUNCA vai para o git.
#
#   Windows:  Copy-Item infra\.env.example infra\.env
#   Linux:    cp infra/.env.example infra/.env
#
# Regra: NENHUM valor real aqui. Tudo que aparece abaixo e placeholder obvio.
# Variaveis marcadas [OBRIGATORIA] fazem o `docker compose config` falhar se
# estiverem vazias — de proposito: e melhor quebrar cedo do que subir errado.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. IDENTIDADE DO AMBIENTE
# -----------------------------------------------------------------------------

# Nome do projeto Compose. Prefixa containers, volumes e a rede interna.
# Use nomes distintos para hml e prd na mesma VPS (ex.: ponto-hml, ponto-prd).
COMPOSE_PROJECT_NAME=ponto

# Ambiente logico da aplicacao: dev | hml | prd.
# Controla nivel de log, exposicao de docs, seeds e ambiente no Sentry.
AMBIENTE=dev

# Fuso horario de todos os containers. O calculo de jornada, o adicional
# noturno e a virada de dia dependem disso estar correto e uniforme.
TZ=America/Sao_Paulo

# Nivel de log dos servicos Python: DEBUG | INFO | WARNING | ERROR.
LOG_LEVEL=INFO


# -----------------------------------------------------------------------------
# 2. DOMINIO E TRAEFIK
# -----------------------------------------------------------------------------

# [OBRIGATORIA] Dominio raiz. As rotas sao derivadas dele:
#   ponto.${DOMINIO}       -> web (Next.js)
#   api.ponto.${DOMINIO}   -> api (FastAPI)
#   dev.ponto.${DOMINIO}   -> device-gw (Push/Monitor Control iD)
#   docs.ponto.${DOMINIO}  -> portal OpenAPI
DOMINIO=exemplo.com.br

# Nome da rede Docker EXTERNA do Traefik global que ja roda na VPS.
# Ela nao e criada por este compose. Confira com: docker network ls
TRAEFIK_NETWORK=traefik

# Nome do certificate resolver configurado no Traefik global (ACME/Let's Encrypt).
TRAEFIK_CERTRESOLVER=letsencrypt

# Middlewares do Traefik aplicados a rotas administrativas (ex.: console do
# MinIO, se voce optar por expo-lo). Deve ser um middleware de allowlist de IP
# ja definido no Traefik global. Formato: nome@provider, separados por virgula.
# Vazio = a rota administrativa nao sobe. Fail closed e intencional.
TRAEFIK_ADMIN_MIDDLEWARES=


# -----------------------------------------------------------------------------
# 3. IMAGENS E BUILD
# -----------------------------------------------------------------------------

# Registry de destino das imagens construidas pelo CI.
REGISTRY=ghcr.io/henriquehmas-rgb

# Tag das imagens. Em prd, use o SHA curto do commit em vez de "latest".
TAG=latest


# -----------------------------------------------------------------------------
# 4. POSTGRESQL 16
# -----------------------------------------------------------------------------

# [OBRIGATORIA] Usuario dono do banco da aplicacao.
POSTGRES_USER=ponto

# [OBRIGATORIA] Senha do usuario. Gere aleatoria com 32+ caracteres.
# POSTGRES_USER/POSTGRES_PASSWORD sao a credencial ADMINISTRATIVA (a imagem
# oficial do Postgres sempre cria POSTGRES_USER como SUPERUSER) -- usada
# SOMENTE por quem roda migration (Alembic, humano ou CI). Os servicos
# api/worker/scheduler/device-gw NUNCA conectam com esta credencial: RLS nao
# se aplica a superusuario (ADR-001), entao usa-la em runtime desliga o
# isolamento por tenant por inteiro. Ver POSTGRES_APP_PASSWORD abaixo.
POSTGRES_PASSWORD=troque-me

# [OBRIGATORIA] Senha da role de LOGIN de privilegio minimo que a aplicacao
# usa em runtime (`ponto_app_runtime`, membro de `ponto_app`, sem BYPASSRLS,
# criada pela migration 0004_role_login_app -- NAO "ponto_app_login", nome ja
# usado por uma role de teste isolada em tests/f1/rbac/conftest.py). Gere
# aleatoria com 32+
# caracteres, DIFERENTE de POSTGRES_PASSWORD. Rode `alembic upgrade head` com
# esta variavel definida no ambiente antes de subir os servicos pela primeira
# vez (ou depois de trocar o valor), senao a role fica com a senha antiga ou
# com o fallback de desenvolvimento (ver docstring da migration).
POSTGRES_APP_PASSWORD=troque-me-tambem

# [OBRIGATORIA] Senha da role de SUPORTE (`ponto_app_suporte`, criada pela
# migration 0005_role_suporte_bypassrls). E a UNICA role de LOGIN do sistema
# com BYPASSRLS -- usada exclusivamente por GET /v1/tenants e POST /v1/tenants
# (`app/db/sessao_suporte.py`), atras da permissao `tenants.suporte`. Ela NAO
# e membro de `ponto_app`: recebe so SELECT/INSERT em `tenants` e `auditoria`,
# entao mesmo com o bypass nao alcanca dado de cliente nenhum. Gere aleatoria
# com 32+ caracteres, DIFERENTE das duas acima, e rode `alembic upgrade head`
# com a variavel definida (sem ela a role fica com o fallback publico de
# desenvolvimento -- ver docstring da migration). Trate-a como a credencial
# mais sensivel do arquivo.
POSTGRES_SUPORTE_PASSWORD=troque-me-e-guarde-bem

# [OPCIONAL] URL completa da sessao de suporte. Vazia (o normal) faz a API
# derivar de DATABASE_URL trocando so usuario/senha por
# ponto_app_suporte/POSTGRES_SUPORTE_PASSWORD. Preencha apenas se a sessao de
# suporte precisar de outro host/porta/base.
# DATABASE_URL_SUPORTE=

# [OBRIGATORIA] Nome do banco.
POSTGRES_DB=ponto

# Porta publicada no host — SOMENTE no override de desenvolvimento.
# Em producao o Postgres nao publica porta nenhuma.
POSTGRES_PORT=5432

# Ajuste de capacidade. api + worker + scheduler somam pools; deixe folga.
POSTGRES_MAX_CONNECTIONS=200
POSTGRES_SHARED_BUFFERS=512MB

# URL usada por ferramentas que rodam FORA do container (Alembic no host,
# psql local, scripts). Dentro do compose a URL e montada automaticamente.
# Use asyncpg para a app e psycopg para ferramentas sincronas, se preciso.
DATABASE_URL=postgresql+asyncpg://ponto:troque-me@localhost:5432/ponto


# -----------------------------------------------------------------------------
# 5. REDIS 7 (fila ARQ, cache, rate limit)
# -----------------------------------------------------------------------------

# [OBRIGATORIA] Senha do Redis (--requirepass). Gere aleatoria com 32+ chars.
REDIS_PASSWORD=troque-me-tambem

# Indice do banco Redis usado pela aplicacao (0-15).
REDIS_DB=0

# Teto de memoria. A politica e noeviction: fila de job nao pode ser descartada.
REDIS_MAXMEMORY=512mb

# Porta publicada no host — SOMENTE em desenvolvimento.
REDIS_PORT=6379

# URL para ferramentas fora do container.
REDIS_URL=redis://:troque-me-tambem@localhost:6379/0


# -----------------------------------------------------------------------------
# 6. MINIO (objetos: fotos de captura, anexos, PDFs, AFD/AEJ, .p7s)
# -----------------------------------------------------------------------------

# [OBRIGATORIA] Usuario root do MinIO (equivale ao access key).
MINIO_ROOT_USER=ponto-minio

# [OBRIGATORIA] Senha root do MinIO (secret key). Minimo 8 chars; use 32+.
MINIO_ROOT_PASSWORD=troque-me-no-minio

# Bucket padrao da aplicacao. Criado pelo bootstrap (make bootstrap).
MINIO_BUCKET=ponto

# Regiao declarada (S3 compatibility). Nao precisa existir de verdade.
MINIO_REGION=us-east-1

# Console web do MinIO: on | off. Mantenha on, mas nao publique a porta em prd.
MINIO_BROWSER=on

# Usar HTTPS ao falar com o MinIO. Dentro da rede interna e http (false).
MINIO_SECURE=false

# Portas publicadas no host — SOMENTE em desenvolvimento.
# Em producao o console e acessado por tunel SSH:
#   ssh -L 9001:localhost:9001 usuario@vps
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001


# -----------------------------------------------------------------------------
# 7. CHAVES JWT (RS256 — assinatura e verificacao de token)
# -----------------------------------------------------------------------------
# As chaves sao geradas fora do git (make keys / .\tasks.ps1 keys) e montadas
# somente-leitura em /run/secrets/jwt. NUNCA versione o par de chaves.

# Diretorio no HOST que contem private.pem e public.pem.
JWT_KEYS_DIR=./keys

# Caminho da chave privada DENTRO do container. Assina os access/refresh tokens.
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt/private.pem

# Caminho da chave publica DENTRO do container. Verifica tokens e alimenta o JWKS.
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt/public.pem

# Tempos de vida dos tokens, em segundos.
JWT_ACCESS_TTL_S=900
JWT_REFRESH_TTL_S=2592000

# Emissor declarado no claim `iss`.
JWT_ISSUER=https://api.ponto.exemplo.com.br


# -----------------------------------------------------------------------------
# 8. API (FastAPI)
# -----------------------------------------------------------------------------

# Numero de workers do uvicorn/gunicorn em producao.
API_WORKERS=4

# Origens permitidas em CORS, separadas por virgula. Sem curinga em producao.
CORS_ORIGENS=https://ponto.exemplo.com.br

# Porta publicada no host — SOMENTE em desenvolvimento.
API_PORT=8000

# IPs/CIDRs do(s) proxy(s) reverso(s) de confianca (Traefik), separados por
# virgula (F14/A2, hardening). So quando o IP do socket IMEDIATO da conexao
# esta nesta lista a API le X-Forwarded-For/X-Real-IP para descobrir o IP do
# usuario final -- vazio (padrao) desliga a confianca por completo e usa
# sempre o IP do socket, mesmo comportamento de antes deste mecanismo
# existir. Preencha com o IP (ou faixa) que o container `api` realmente
# enxerga como origem das conexoes vindas do Traefik na rede `ponto-interna`
# do seu deploy -- nao ha valor generico correto aqui.
PROXIES_CONFIAVEIS=


# -----------------------------------------------------------------------------
# 9. WORKERS ARQ (worker e scheduler)
# -----------------------------------------------------------------------------

# Caminho de importacao da classe WorkerSettings do ARQ.
# Usado no `command` do container e tambem pelo healthcheck (`arq --check`).
ARQ_WORKER_SETTINGS=worker.main.WorkerSettings

# Caminho de importacao das settings do scheduler (jobs cron).
ARQ_SCHEDULER_SETTINGS=worker.scheduler.SchedulerSettings

# Jobs simultaneos por processo.
ARQ_MAX_JOBS=10
ARQ_SCHEDULER_MAX_JOBS=2


# -----------------------------------------------------------------------------
# 10. FACIAL-SVC (motor facial self-hosted)
# -----------------------------------------------------------------------------

# URL interna do servico facial. Nao exponha na internet: biometria nao sai
# da rede privada (decisao D4 + LGPD art. 5, II).
FACIAL_SVC_URL=http://facial-svc:8000

# Diretorio dos pesos ONNX dentro do container (volume facial-models).
FACIAL_MODEL_DIR=/models

# Versao do modelo em uso. Fica gravada em cada enrollment para permitir
# troca de motor sem perder rastreabilidade.
FACIAL_MODEL_VERSAO=arcface-r100-v1

# Limiar de similaridade para aceitar o match (0.0 a 1.0). Calibrar por cliente.
FACIAL_LIMIAR_SIMILARIDADE=0.42

# CA para mTLS entre device-gw e facial-svc. Vazio desliga o mTLS (so em dev).
FACIAL_MTLS_CA_PATH=

# Certificado/chave que o PROPRIO facial-svc apresenta como servidor TLS
# (F14/A2). Os tres (estes dois + FACIAL_MTLS_CA_PATH acima) precisam estar
# preenchidos para o mTLS ligar de verdade -- qualquer um vazio, o servico
# sobe em HTTP puro (padrao, igual a antes desta fase).
FACIAL_TLS_CERT_PATH=
FACIAL_TLS_KEY_PATH=

# Diretorio no HOST montado em /run/secrets/facial-tls (so leitura) dentro do
# container facial-svc -- de onde FACIAL_TLS_CERT_PATH/FACIAL_TLS_KEY_PATH/
# FACIAL_MTLS_CA_PATH devem apontar quando preenchidos. Vazio nao monta nada
# de sensivel (cai no default inofensivo do compose).
FACIAL_CERTS_DIR=

# Porta publicada no host — SOMENTE em desenvolvimento.
FACIAL_PORT=8010


# -----------------------------------------------------------------------------
# 11. CONTROL iD (terminal iDFace) — device-gw
# -----------------------------------------------------------------------------

# Usuario administrativo do terminal, usado em login.fcgi.
CONTROLID_USUARIO=admin

# Senha do usuario administrativo do terminal.
CONTROLID_SENHA=troque-me-no-terminal

# Timeout, em segundos, das chamadas *.fcgi ao terminal.
CONTROLID_TIMEOUT_S=10

# Token compartilhado que o terminal apresenta ao chamar dev.ponto.${DOMINIO}
# no modo Push. Gere aleatorio (32+ chars) e cadastre no equipamento.
CONTROLID_PUSH_TOKEN=troque-me-token-push

# true = usa o simulador de terminal embutido, sem hardware. Padrao em dev.
CONTROLID_SIMULADOR=false

# Porta publicada no host — SOMENTE em desenvolvimento.
DEVICE_GW_PORT=8001


# -----------------------------------------------------------------------------
# 12. CONFORMIDADE REP-P (Portaria MTP 671/2021)
# -----------------------------------------------------------------------------

# Numero do registro do programa no INPI. Vai no cabecalho do AFD, SO DIGITOS.
# Enquanto o registro nao sai, deixe vazio: o gerador emite AFD sem o campo
# preenchido e marca o arquivo como nao homologado.
INPI_NUMERO=

# Caminho DENTRO do container para o certificado e-CNPJ A1 ICP-Brasil (.pfx/.p12)
# usado na assinatura CAdES do AFD, do AEJ e dos comprovantes.
# O arquivo e montado por volume separado e nunca entra no git.
CERT_ICP_PATH=/run/secrets/icp/e-cnpj.pfx

# Senha do certificado A1. Vazio enquanto o certificado nao existir.
CERT_ICP_SENHA=

# Retencao de marcacoes, em dias (5 anos = exigencia legal).
RETENCAO_MARCACOES_DIAS=1825

# Retencao de imagens de captura facial, em dias (minimizacao LGPD).
RETENCAO_IMAGENS_DIAS=30


# -----------------------------------------------------------------------------
# 13. OBSERVABILIDADE
# -----------------------------------------------------------------------------

# DSN do Sentry para os servicos backend. Vazio desliga o Sentry.
SENTRY_DSN=

# DSN do Sentry para o front Next.js (projeto separado, e publico no browser).
SENTRY_DSN_WEB=

# Endpoint OTLP do coletor OpenTelemetry (traces e metricas).
# Ex.: http://otel-collector:4317 . Vazio desliga a exportacao.
OTEL_EXPORTER_OTLP_ENDPOINT=


# -----------------------------------------------------------------------------
# 14. WEB (Next.js) — somente desenvolvimento
# -----------------------------------------------------------------------------

# Porta publicada no host em desenvolvimento.
WEB_PORT=3000


# -----------------------------------------------------------------------------
# 15. SSO — OIDC (Google Workspace, Microsoft Entra ID) — F13/A9 (RFC-018/ADR-013)
# -----------------------------------------------------------------------------

# App OAuth/OIDC UNICO, compartilhado por TODOS os tenants (ADR-013: nunca por
# tenant). Registrar em console.cloud.google.com, tipo "Web application",
# redirect URI = ${WEB_BASE_URL}/sso/callback/google -- pagina do SPA, NUNCA
# a API diretamente: o navegador so sabe navegar ate essa URL, e e a propria
# pagina que chama GET /v1/sso/google/callback por fetch (ver
# apps/api/app/routers/sso.py:_redirect_uri).
SSO_GOOGLE_CLIENT_ID=
SSO_GOOGLE_CLIENT_SECRET=

# App OAuth/OIDC UNICO no Microsoft Entra ID (registro multi-tenant,
# "Accounts in any organizational directory"), redirect URI =
# ${WEB_BASE_URL}/sso/callback/entra_id (mesma nota acima: pagina do SPA).
SSO_ENTRA_CLIENT_ID=
SSO_ENTRA_CLIENT_SECRET=

# Chave simetrica (32+ bytes aleatorios) que assina o `state` anti-CSRF do
# fluxo OIDC. Troque-a invalida todo `state` em voo (janela de 10 minutos) —
# seguro reiniciar a qualquer momento, nunca reusar entre ambientes.
SSO_ESTADO_CHAVE_SECRETA=troque-me-chave-de-estado-sso


# -----------------------------------------------------------------------------
# 15. SSO — SAML 2.0 — F13/A10 (RFC-018/ADR-013)
# -----------------------------------------------------------------------------

# Chave simetrica (HS256, 32+ bytes aleatorios) que assina o RelayState do
# fluxo SAML (apps/api/app/identidade/sso/saml/estado.py). Mesma familia da
# SSO_ESTADO_CHAVE_SECRETA acima (fluxo OIDC, F13/A9), campo proprio: o
# RelayState carrega tenant_id + o ID do AuthnRequest (correlacao
# InResponseTo) + nonce, nunca segredo do IdP -- entityId/ssoUrl/certificado
# X.509 de cada tenant sao dado publico e vivem em tenant_configuracoes sem
# cifra (ADR-013 item 3), nunca aqui. Trocar esta chave invalida todo
# RelayState em voo (janela de 5 minutos) — seguro reiniciar a qualquer
# momento, nunca reusar entre ambientes.
SSO_SAML_ESTADO_CHAVE=troque-me-chave-de-estado-saml


# -----------------------------------------------------------------------------
# 15. WEBHOOKS (entrega assinada de eventos, F13)
# -----------------------------------------------------------------------------

# Chave mestra do envelope encryption (AES-256-GCM) do segredo HMAC de cada
# webhook (`webhooks.segredo_hmac_cifrado`). Hex de 32 bytes, gerada com
# `openssl rand -hex 32`, NUNCA versionada. Copia deliberada do padrao de
# PONTO_TERMINAL_CHAVE_MESTRA (apps/api/app/terminais/cifra.py) com chave
# propria de dominio -- ver apps/api/app/integracoes/webhooks/cifra.py.
PONTO_WEBHOOK_CHAVE_MESTRA=


# -----------------------------------------------------------------------------
# 16. SANDBOX (portal de desenvolvedor /desenvolvedores, F13/A2)
# -----------------------------------------------------------------------------

# Identidade tecnica do tenant de demonstracao semeado por
# `apps/api/app/integracoes/sandbox/semear.py` (T8). Os mesmos tres valores
# sao lidos dos dois lados: pelo script de semeadura (apps/api) e pelo proxy
# do console "tente agora" (apps/web/src/app/desenvolvedores/api/sandbox/
# route.ts, server-only, NUNCA prefixado com NEXT_PUBLIC_). Sem eles
# configurados no servico `web`, o console responde 503 PONTO-INT-001 com
# instrucao de como resolver.
PONTO_SANDBOX_TENANT_SLUG=sandbox-demo
PONTO_SANDBOX_ADMIN_EMAIL=portal-sandbox@sandbox-demo.ponto.seeg.com.br

# Senha do usuario administrador de demonstracao. SEM valor padrao de
# proposito (mesma politica de PONTO_SEED_ADMIN_SENHA, seed_dev.py): o
# script de semeadura recusa rodar sem ela. Nao e um segredo de producao --
# o tenant de demonstracao e inteiramente sintetico, sem dado real -- mas
# ainda assim nunca versionada com valor real.
PONTO_SANDBOX_ADMIN_SENHA=
