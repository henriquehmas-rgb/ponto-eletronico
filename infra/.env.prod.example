# =============================================================================
# Ponto Eletronico — modelo de variaveis do ambiente de PRODUCAO (prd)
# =============================================================================
# Este arquivo acompanha infra/docker-compose.prod.yml. Homologacao continua
# usando infra/.env.example + infra/docker-compose.yml — nao misture os dois.
#
# Copie para infra/.env.prod na VPS e preencha:
#     cp infra/.env.prod.example infra/.env.prod
#     chmod 600 infra/.env.prod        # nunca 644: contem segredo real
#
# REGRA ABSOLUTA: nenhum valor real neste arquivo de exemplo. Tudo abaixo e
# placeholder obvio ou vazio. `.env.prod` NUNCA vai para o git (o job `infra`
# do CI reprova qualquer arquivo `.env*` versionado que nao termine em
# `.example`).
#
# Convencao de marcacao:
#   [OBRIGATORIA]  o compose de producao falha com `:?` se estiver vazia.
#                  Isso e intencional: quebrar antes do `up` e melhor do que
#                  subir producao com config incompleta.
#   [opcional]     tem default seguro no compose.
#
# Variaveis que EXISTEM em .env.example (hml) e NAO existem aqui, de proposito:
#   AMBIENTE            fixo em `prd` dentro do compose de producao.
#   MINIO_BROWSER       fixo em `off`.
#   CONTROLID_SIMULADOR fixo em `false`.
#   COMPOSE_PROJECT_NAME  producao usa `-p ponto-prd` na linha de comando e
#                       nomes de volume/rede literais; nao depende desta var.
#   *_PORT              producao nao publica porta no host (quem escuta e o
#                       Traefik). As portas de dev vivem em docker-compose.dev.yml.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. IDENTIDADE DO AMBIENTE
# -----------------------------------------------------------------------------

# [opcional] Fuso de todos os containers. O calculo de jornada, o adicional
# noturno e a virada de dia dependem disso estar correto e uniforme.
TZ=America/Sao_Paulo

# [opcional] Nivel de log: DEBUG | INFO | WARNING | ERROR.
# Em producao use INFO ou acima. DEBUG loga payload e vaza dado pessoal.
LOG_LEVEL=INFO


# -----------------------------------------------------------------------------
# 2. DOMINIO E TRAEFIK  (decisao/posse do dono do produto)
# -----------------------------------------------------------------------------

# [OBRIGATORIA] Dominio raiz de PRODUCAO — precisa ser diferente do de hml.
# As quatro rotas sao derivadas dele e os quatro registros DNS (A/AAAA)
# precisam apontar para o IP da VPS ANTES do primeiro `up`, senao o Traefik
# nao consegue emitir certificado:
#   ponto.${DOMINIO}       -> web (Next.js)
#   api.ponto.${DOMINIO}   -> api (FastAPI)
#   dev.ponto.${DOMINIO}   -> device-gw (Push/Monitor Control iD)
#   docs.ponto.${DOMINIO}  -> portal OpenAPI
DOMINIO=PREENCHER-dominio-de-producao.com.br

# [opcional] Rede Docker EXTERNA do Traefik global que ja roda na VPS.
# Ela nao e criada por este compose. Confira com: docker network ls
TRAEFIK_NETWORK=traefik

# [opcional] Nome do certificate resolver ACME/Let's Encrypt configurado no
# Traefik global. O certificado TLS publico e emitido POR ELE, nao por este
# stack — nao ha arquivo de certificado a colocar aqui. Se o Traefik da VPS
# usa outro nome de resolver, corrija.
TRAEFIK_CERTRESOLVER=letsencrypt


# -----------------------------------------------------------------------------
# 3. IMAGENS
# -----------------------------------------------------------------------------

# [OBRIGATORIA] Registry de onde as imagens sao puxadas. Producao NUNCA
# constroi imagem na VPS: o compose de prd nao tem secao `build:`.
REGISTRY=ghcr.io/henriquehmas-rgb

# [OBRIGATORIA] Tag imutavel das imagens. Em producao use o SHA CURTO do
# commit (ex.: a1b2c3d), nunca `latest` — o rollback depende de a tag anterior
# continuar apontando para o mesmo binario.
TAG=PREENCHER-sha-curto


# -----------------------------------------------------------------------------
# 4. POSTGRESQL 16
# -----------------------------------------------------------------------------

# [OBRIGATORIA] Credencial ADMINISTRATIVA (a imagem oficial do Postgres cria
# POSTGRES_USER como SUPERUSER). Usada SO por quem roda migration (Alembic).
# Nenhum servico da aplicacao usa esta credencial — RLS nao se aplica a
# superusuario (ADR-001).
POSTGRES_USER=PREENCHER-usuario-admin
# [OBRIGATORIA] Aleatoria, 32+ caracteres. Diferente da senha de hml.
POSTGRES_PASSWORD=PREENCHER-senha-aleatoria-32-chars
# [OBRIGATORIA] Nome do banco de producao.
POSTGRES_DB=PREENCHER-nome-do-banco

# [OBRIGATORIA] Senha da role de LOGIN de privilegio minimo `ponto_app_runtime`
# criada pela migration 0004_role_login_app. E ESTA que api/worker/scheduler/
# device-gw usam — a que RLS realmente restringe.
POSTGRES_APP_PASSWORD=PREENCHER-senha-aleatoria-32-chars

# [opcional] Tuning. Ajuste conforme a RAM da VPS.
POSTGRES_MAX_CONNECTIONS=200
POSTGRES_SHARED_BUFFERS=1GB


# -----------------------------------------------------------------------------
# 5. REDIS 7
# -----------------------------------------------------------------------------

# [OBRIGATORIA] Senha do Redis (--requirepass). Aleatoria, 32+ caracteres.
REDIS_PASSWORD=PREENCHER-senha-aleatoria-32-chars
# [opcional]
REDIS_DB=0
REDIS_MAXMEMORY=1gb


# -----------------------------------------------------------------------------
# 6. MINIO
# -----------------------------------------------------------------------------
# O console web e desligado no compose de producao (MINIO_BROWSER=off literal,
# porta 9001 nao exposta). Administracao de bucket: tunel SSH + cliente `mc`.

# [OBRIGATORIA] Credencial root do MinIO. Aleatoria, 32+ caracteres.
MINIO_ROOT_USER=PREENCHER-usuario-minio
MINIO_ROOT_PASSWORD=PREENCHER-senha-aleatoria-32-chars

# [opcional]
MINIO_BUCKET=ponto
MINIO_REGION=us-east-1
# false porque o MinIO fica na rede interna, sem TLS proprio. So mude para
# true se voce colocar TLS no proprio MinIO.
MINIO_SECURE=false


# -----------------------------------------------------------------------------
# 7. CHAVES JWT
# -----------------------------------------------------------------------------

# [OBRIGATORIA] Diretorio NO HOST com o par de chaves RSA/EdDSA gerado fora do
# git (`make keys`), montado somente-leitura em /run/secrets/jwt.
# Producao deve ter par PROPRIO — nunca reaproveite o de homologacao.
# Permissao sugerida: dir 700, private.pem 600, dono root.
JWT_KEYS_DIR=/docker/ponto-prd/keys

# [opcional] Caminhos DENTRO do container.
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt/private.pem
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt/public.pem


# -----------------------------------------------------------------------------
# 8. API
# -----------------------------------------------------------------------------

# [opcional] Origens permitidas em CORS. Default: https://ponto.${DOMINIO}.
# So preencha se houver front adicional (app, dominio de parceiro).
CORS_ORIGENS=

# [OBRIGATORIA em prd] CIDR(s) do proxy confiavel — a rede Docker do Traefik.
# Sem isso, o IP gravado na auditoria de cada marcacao e o do proxy, e nao o do
# usuario. Descubra com:
#   docker network inspect traefik -f '{{(index .IPAM.Config 0).Subnet}}'
PROXIES_CONFIAVEIS=PREENCHER-cidr-da-rede-do-traefik

# [opcional] Numero de workers Uvicorn.
API_WORKERS=4


# -----------------------------------------------------------------------------
# 9. ARQ (worker e scheduler)
# -----------------------------------------------------------------------------
ARQ_WORKER_SETTINGS=worker.main.WorkerSettings
ARQ_SCHEDULER_SETTINGS=worker.scheduler.SchedulerSettings
ARQ_MAX_JOBS=10
ARQ_SCHEDULER_MAX_JOBS=2


# -----------------------------------------------------------------------------
# 10. MOTOR FACIAL — mTLS OBRIGATORIO EM PRODUCAO (F14/A2)
# -----------------------------------------------------------------------------
# Em dev/hml, deixar estas variaveis vazias faz `facial/servidor.py` subir em
# HTTP puro. Em producao isso significaria biometria trafegando em claro entre
# containers, entao o compose de prd exige as tres + o diretorio de montagem.
# Sao certificados de uma CA INTERNA (nao Let's Encrypt, e NADA a ver com o
# ICP-Brasil da secao de assinatura): emita com
# `infra/gerar-certificados-mtls-facial.sh`. Ver docs/runbook-deploy-producao.md,
# passo 4b.

# [OBRIGATORIA] Diretorio NO HOST com ca.pem, servidor.pem e servidor.key,
# montado somente-leitura em /run/secrets/facial-tls DENTRO DO FACIAL-SVC.
# Permissao 700, dono root.
FACIAL_CERTS_DIR=/docker/ponto-prd/certs-facial

# [OBRIGATORIA] Diretorio NO HOST com ca.pem, cliente.pem e cliente.key,
# montado somente-leitura em /run/secrets/facial-tls DENTRO DA API. Diretorio
# separado de proposito: a chave privada do servidor nunca fica visivel dentro
# da api, nem a do cliente dentro do facial-svc. Permissao 700, dono root.
FACIAL_CERTS_CLIENTE_DIR=/docker/ponto-prd/certs-facial-api

# [OBRIGATORIA] Caminhos DENTRO do container. O ponto de montagem e o mesmo nos
# dois servicos, e cada diretorio de host tem sua propria copia da CA — por isso
# FACIAL_MTLS_CA_PATH e um valor so, valido dos dois lados.
FACIAL_MTLS_CA_PATH=/run/secrets/facial-tls/ca.pem
# ...lado SERVIDOR (facial-svc):
FACIAL_TLS_CERT_PATH=/run/secrets/facial-tls/servidor.pem
FACIAL_TLS_KEY_PATH=/run/secrets/facial-tls/servidor.key
# ...lado CLIENTE (api, `app/biometria/cliente_facial.py`):
FACIAL_MTLS_CERT_PATH=/run/secrets/facial-tls/cliente.pem
FACIAL_MTLS_KEY_PATH=/run/secrets/facial-tls/cliente.key

# [OBRIGATORIA] Versao do modelo em uso; fica gravada em cada enrollment para
# permitir troca de motor sem perder rastreabilidade.
FACIAL_MODEL_VERSAO=arcface-r100-v1

# [opcional]
FACIAL_MODEL_DIR=/models
FACIAL_LIMIAR_SIMILARIDADE=0.42
# https, nao http: com mTLS obrigatorio o facial-svc nao responde em texto
# claro. Este e o default do compose de prd; so mude se souber o que faz.
FACIAL_SVC_URL=https://facial-svc:8000


# -----------------------------------------------------------------------------
# 11. CONTROL iD (terminal iDFace) — device-gw
# -----------------------------------------------------------------------------
# O simulador de terminal e travado em `false` dentro do compose de producao.

# [OBRIGATORIA] Usuario/senha administrativos do terminal (login.fcgi).
CONTROLID_USUARIO=PREENCHER-usuario-terminal
CONTROLID_SENHA=PREENCHER-senha-terminal
# [OBRIGATORIA] Token que os terminais apresentam no Push. Aleatorio, 32+.
CONTROLID_PUSH_TOKEN=PREENCHER-token-aleatorio-32-chars
# [opcional]
CONTROLID_TIMEOUT_S=10


# -----------------------------------------------------------------------------
# 12. ASSINATURA ICP-BRASIL (AFD/AEJ e espelhos .p7s)
# -----------------------------------------------------------------------------
# O certificado A1 (.pfx/.p12) e comprado pelo dono do produto junto a uma AC
# credenciada ICP-Brasil. NAO e o mesmo certificado do TLS do site.

# [OBRIGATORIA] Diretorio NO HOST com o .pfx, montado em /run/secrets/icp (ro).
CERT_ICP_DIR=/docker/ponto-prd/certs-icp
# [OBRIGATORIA] Caminho DENTRO do container.
CERT_ICP_PATH=/run/secrets/icp/certificado.pfx
# [OBRIGATORIA] Senha do .pfx.
CERT_ICP_SENHA=PREENCHER-senha-do-pfx

# [opcional] Numero do registro do software no INPI, impresso nos relatorios.
INPI_NUMERO=


# -----------------------------------------------------------------------------
# 13. OBSERVABILIDADE
# -----------------------------------------------------------------------------

# [OBRIGATORIA em prd] DSN do Sentry dos servicos backend. O compose de
# producao usa `:?` aqui: sem monitoramento de erro, o primeiro a saber de um
# incidente e o cliente. Se voce decidir conscientemente nao usar Sentry,
# troque o `:?` por `:-` no compose e registre a decisao no runbook.
SENTRY_DSN=https://PREENCHER@PREENCHER.ingest.sentry.io/0

# [opcional] DSN separado do front Next.js.
SENTRY_DSN_WEB=

# [opcional] Coletor OTLP (OpenTelemetry). Vazio desliga o export de traces.
OTEL_EXPORTER_OTLP_ENDPOINT=


# -----------------------------------------------------------------------------
# 14. RETENCAO / LGPD
# -----------------------------------------------------------------------------
# ATENCAO: assim como em infra/.env.example (hml), estas duas variaveis estao
# aqui por paridade de documentacao mas HOJE NAO sao injetadas nos containers
# por nenhum dos dois composes. Antes do primeiro deploy real, confirme com o
# codigo de expurgo de onde ele le a retencao e, se for de env, adicione as
# duas ao bloco x-python-env do compose de producao.
RETENCAO_MARCACOES_DIAS=1825
RETENCAO_IMAGENS_DIAS=365
